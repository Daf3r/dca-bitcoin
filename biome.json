{
	"$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
	"files": {
		"includes": ["app/static/*.js", "tests/*.mjs"]
	},
	"formatter": {
		"enabled": false
	},
	"assist": {
		"enabled": false
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"suspicious": {
				"useIterableCallbackReturn": "off"
			},
			"style": {
				"useTemplate": "off"
			},
			"complexity": {
				"useMathMinMax": "off"
			}
		}
	}
}
