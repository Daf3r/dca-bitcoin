# Respaldos: una copia cada N horas y cuántas se conservan.
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=30

# Respaldos cifrados (opcional): con una clave, cada respaldo queda como libro-FECHA.db.cifrado y no se guarda copia en claro.
# SIN ESTA CLAVE NO SE PUEDEN ABRIR: guárdala aparte (por ejemplo en tu gestor de contraseñas). No la subas a git.
# BACKUP_CLAVE=
# Modo solo lectura de emergencia (1 = nadie puede escribir; todo se sigue viendo).
# SOLO_LECTURA=0
# Escrituras por minuto y por cuenta antes de frenar (importar un CSV grande cuenta como una).
# LIMITE_ESCRITURAS=120
# El día del próximo halving de Bitcoin (AAAA-MM-DD, hora de El Salvador), para la fiesta del pueblo ese día (campamento 59). La app no
# sabe en qué bloque va la red (llegará con el nodo, campamento 60) y no inventa la fecha: escríbela cuando se sepa con certeza (unos
# días antes del bloque 1,050,000, hacia abril de 2028). Sin ella, no hay fiesta del halving; una fecha mal escrita se ignora.
# HALVING_FECHA=
# Límite de intentos de entrada por IP: descomenta esta línea SOLO cuando Caddy ya ponga X-Cliente-IP con la IP real del visitante
# (README, «Acceso con cuentas»: header_up X-Cliente-IP {http.request.header.CF-Connecting-IP}). Antes de eso la cabecera la podría
# inventar cualquiera; sin la línea, la app desactiva el límite por IP y avisa en el registro (el límite por cuenta sigue).
# CONFIAR_X_CLIENTE_IP=1
