# Respaldos: una copia cada N horas y cuántas se conservan.
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=30

# Respaldos cifrados (opcional): con una clave, cada respaldo queda como libro-FECHA.db.cifrado y no se guarda copia en claro.
# SIN ESTA CLAVE NO SE PUEDEN ABRIR: guárdala aparte (por ejemplo en tu gestor de contraseñas). No la subas a git.
# BACKUP_CLAVE=
# Modo solo lectura de emergencia (1 = nadie puede escribir; todo se sigue viendo).
# SOLO_LECTURA=0
# Escrituras por minuto y por cuenta antes de frenar (importar un CSV grande cuenta como una).
# LIMITE_ESCRITURAS=120
